import Mathlib
import Na.Defs

/-!
# Estimate the Value of Diffenrence

This file develops the estimation of the difference ‖x_k - x*‖, where x_k is generated by the GaussSeidel iterative method. Also the convergence relation between Jacobi iterative method and GaussSeidel iterative method.
-/

section SG_4_2_4
open Matrix Finset BigOperators

variable {n : Nat} {i j : Fin n} {x_star : Fin n → ℝ} {A : Matrix (Fin n) (Fin n) ℝ} {hA : ∀ i, A i i ≠ 0} {b : Fin n → ℝ} {x0 : Fin n → ℝ} [NeZero n]


-- ================== notation def ====================
-- def G-S.x
noncomputable def G_SIterativeVector
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :=
  (GaussSeidel A hA b x0).x

-- def D⁻¹
noncomputable def diagonal_inv
  (A : Matrix (Fin n) (Fin n) ℝ)
  -- (hA : ∀ i, A i i ≠ 0)
  : Matrix (Fin n) (Fin n) ℝ
  :=
  fun i j => if i = j then (1 / (A i j)) else 0

-- def 𝓊 i
noncomputable def Vector_u
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (i : Fin n)
  :=
  ∑ j ∈ {t | t < i}, |(Jacobi A hA b x0).M i j|

-- def ℓ i
noncomputable def Vector_l
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (i : Fin n)
  :=
  ∑ j ∈ {t | t ≥ i}, |(Jacobi A hA b x0).M i j|

-- def μ
noncomputable def mu
  [NeZero n]
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  ℝ
  :=
  have h : (Finset.univ : Finset (Fin n)).Nonempty := Finset.univ_nonempty
  Finset.max' (Finset.univ.image (fun i : Fin n => Vector_u A hA b x0 i / (1 - Vector_l A hA b x0 i))) (by simp [h])


-- ============= local notation ==================
local notation "x" => G_SIterativeVector A hA b x0
local notation "D" => diagPart A
local notation "algJ" => Jacobi A hA b x0
local notation "algG" => GaussSeidel A hA b x0
local notation "D⁻¹" => diagonal_inv A
local notation "L" => -A.lowerPart -- 这个 notation 好像没有起作用
local notation "U" => -A.upperPart -- 这个 notation 好像没有起作用
local notation "𝓊" i => Vector_u A hA b x0 i
local notation "ℓ" i => Vector_l A hA b x0 i
local notation "μ" => mu A hA b x0 -- 这个 notation 好像没有起作用


-- ========= 关于主要变量的等式和不等式 =================
-- ∀ i, (l i) + (u i) ≤ ‖ B ‖_∞
lemma SG_2_1_4
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  ∀ i, (Vector_l A hA b x0 i) + (Vector_u A hA b x0 i) ≤ ‖(Jacobi A hA b x0).M‖_∞
  := by
  sorry

-- ∀ k, ‖x k - x_star‖ ≤ ‖L₁‖_∞ ^ k / (1 - ‖L₁‖_∞)
lemma SG_4_2_2_corollary
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  :
  ∀ k, ‖G_SIterativeVector A hA b x0 k - x_star‖ ≤ (‖(GaussSeidel A hA b x0).M‖_∞ ^ k / (1 - ‖(GaussSeidel A hA b x0).M‖_∞)) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖ := by
  sorry

-- ∀ (i : Fin n), ((l i) + u i) < 1
lemma l_i_add_u_i_lt_one
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  :
  ∀ i, (Vector_l A hA b x0 i) + (Vector_u A hA b x0 i) < 1
  := by
  intro i
  calc
    (Vector_l A hA b x0 i) + (Vector_u A hA b x0 i) ≤ ‖(Jacobi A hA b x0).M‖_∞ := by
      exact SG_2_1_4 A hA b x0 i
    _ < 1 := by
      exact h0

-- (𝓊 i) ≥ 0
-- u_i_ge_zero A hA b x0
omit [NeZero n] in
lemma u_i_ge_zero
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  Vector_u A hA b x0 i ≥ 0 := by
  unfold Vector_u
  have hu_i_ge_zero1 : ∀j, |(Jacobi A hA b x0).M i j| ≥ 0 := by
    intro j
    exact abs_nonneg ((Jacobi A hA b x0).M i j)
  exact sum_nonneg fun i_1 a ↦ hu_i_ge_zero1 i_1

-- (ℓ i) < 1
-- l_i_lt_one A hA b x0 h0
lemma l_i_lt_one
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  :
  Vector_l A hA b x0 i < 1 := by
  calc
      Vector_l A hA b x0 i ≤ Vector_l A hA b x0 i  + Vector_u A hA b x0 i := by
        exact (le_add_iff_nonneg_right (Vector_l A hA b x0 i)).mpr (u_i_ge_zero A hA b x0)
      _ < 1 := by
        exact l_i_add_u_i_lt_one A hA b x0 h0 i

-- ℓ i ≥ 0
-- ℓ A hA b x0
omit [NeZero n] in
lemma l_i_ge_zero
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  Vector_l A hA b x0 i ≥ 0
  := by
  unfold Vector_l
  have h1 : ∀ j, |(Jacobi A hA b x0).M i j| ≥ 0 := by
    intro j
    (expose_names; exact abs_nonneg ((Jacobi A hA b x0).M i j))
  exact sum_nonneg fun i_1 a ↦ h1 i_1

-- ∀ i, (u i)/ (1 - (l i)) ≤ (l i) + (u i)
-- h1_lemma1 A hA b x0 h0
lemma h1_lemma1
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  :
  ∀ i, (Vector_u A hA b x0 i)/ (1 - (Vector_l A hA b x0 i)) ≤ (Vector_l A hA b x0 i) + (Vector_u A hA b x0 i)
  := by
  have hhhh : ∀ i, Vector_l A hA b x0 i + Vector_u A hA b x0 i < 1 := by
    intro i
    calc
      Vector_l A hA b x0 i + Vector_u A hA b x0 i ≤ ‖(Jacobi A hA b x0).M‖_∞ := by
        exact SG_2_1_4 A hA b x0 i
      _ < 1 := by
        exact h0
  have h1 :∀ i : Fin n, 0 < 1 - (Vector_l A hA b x0 i) := by
    intro i
    simp only [sub_pos]
    exact l_i_lt_one A hA b x0 h0
  have h2 :∀ i : Fin n,(Vector_u A hA b x0 i) ≤ 1 - (Vector_l A hA b x0 i) := by
    intro i;linarith [hhhh i]
  have h2' : ∀i, (Vector_u A hA b x0 i) < 1 - (Vector_l A hA b x0 i) := by
    intro i
    exact lt_tsub_iff_left.mpr (hhhh i)

  have step1 :∀ i : Fin n, ((Vector_l A hA b x0 i) + (Vector_u A hA b x0 i) )-((Vector_u A hA b x0 i)) / (1 - (Vector_l A hA b x0 i))  ≥ 0 := by
    have t₁ :∀ i : Fin n,((Vector_l A hA b x0 i) + (Vector_u A hA b x0 i)) - ((Vector_u A hA b x0 i)) / (1 - (Vector_l A hA b x0 i)) = (1-(Vector_l A hA b x0 i) - (Vector_u A hA b x0 i))*(Vector_l A hA b x0 i)/(1 - (Vector_l A hA b x0 i)) := by
      intro i
      calc
        ((Vector_l A hA b x0 i) + (Vector_u A hA b x0 i)) - ((Vector_u A hA b x0 i)) / (1 - (Vector_l A hA b x0 i))=(((Vector_l A hA b x0 i) + (Vector_u A hA b x0 i))*(1-(Vector_l A hA b x0 i))-(Vector_u A hA b x0 i))/(1 - (Vector_l A hA b x0 i)):=by
          have denom_ne : 1 - (Vector_l A hA b x0 i) ≠ 0 := by linarith [h1 i]
          field_simp [denom_ne]
        _=(1-(Vector_l A hA b x0 i) - (Vector_u A hA b x0 i))*(Vector_l A hA b x0 i)/(1 - (Vector_l A hA b x0 i)) :=by ring
    intro i
    rw[t₁]
    have num_nonneg :∀ i : Fin n, (1 - (Vector_l A hA b x0 i) - (Vector_u A hA b x0 i)) * (Vector_l A hA b x0 i) ≥ 0 := by
      intro i
      apply mul_nonneg
      · exact sub_nonneg_of_le (h2 i)      -- 1 - l A i - u A i ≥ 0
      · exact l_i_ge_zero A hA b x0
    apply div_nonneg
    exact num_nonneg i
    exact le_of_lt (h1 i)
  intro i
  exact sub_nonneg.mp (step1 i)

-- μ ≤ ‖ B ‖_∞
lemma h1_lemma2
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  :
  mu A hA b x0 ≤ ‖(Jacobi A hA b x0).M‖_∞
  := by
  sorry

-- (u i) / (1 - (l i)) ≤ μ
-- h2_lemma2 A hA b x0
lemma h2_lemma2
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  ∀i, (Vector_u A hA b x0 i) / (1 - (Vector_l A hA b x0 i)) ≤ mu A hA b x0
  := by
  intro i
  unfold mu

  have mem : (Vector_u A hA b x0 i / (1 - Vector_l A hA b x0 i)) ∈(Finset.univ.image (fun i : Fin n => Vector_u A hA b x0 i / (1 - Vector_l A hA b x0 i))) := by
    apply Finset.mem_image_of_mem
    simp only [mem_univ]
  apply Finset.le_max'
  simp only [mem_image, mem_univ, true_and, exists_apply_eq_apply]

