-- ∃ (x_0 : Fin n → ℝ), (‖x_0‖ = 1) ∧ (‖L₁‖_∞ = ‖L₁ *ᵥ x_0‖)
lemma h2_lemma1
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  :
  ∃ (x_0 : Fin n → ℝ), (‖x_0‖ = 1) ∧ (‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖) := by
  sorry

-- ∀ (i : Fin n), |x_0 i| ≤ 1
lemma x_0_i_le_one
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ∀ i, |x_0 i| ≤ 1
  := by
  intro i
  calc
    |x_0 i| ≤ ‖x_0‖ := by
      sorry
    _ = 1 := by
      exact x_0_eq_one

