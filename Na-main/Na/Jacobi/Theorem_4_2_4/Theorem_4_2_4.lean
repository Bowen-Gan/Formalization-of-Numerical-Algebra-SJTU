  sorry

-- y = (D⁻¹ * L) *ᵥ y + (D⁻¹ * U) *ᵥ x_0
-- y_eq A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec
lemma y_eq
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  (GaussSeidel A hA b x0).M *ᵥ x_0 = (diagonal_inv A * (-lowerPart A)) *ᵥ (GaussSeidel A hA b x0).M *ᵥ x_0 + (diagonal_inv A * -upperPart A) *ᵥ x_0 := by
  let y := (GaussSeidel A hA b x0).M *ᵥ x_0
  sorry

-- y = B.lowerPart *ᵥ y + B.upperPart *ᵥ x_0
-- y_eq1 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec
lemma y_eq1
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  (GaussSeidel A hA b x0).M *ᵥ x_0
  =
  lowerPart (Jacobi A hA b x0).M *ᵥ (GaussSeidel A hA b x0).M *ᵥ x_0
  +
  upperPart (Jacobi A hA b x0).M *ᵥ x_0
  := by
  conv =>
    lhs
    rw [y_eq A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec]
  rw [← B_upperPart A hA b x0, ← B_lowerPart A hA b x0]

-- y i = ∑ j ∈ {t | t ≥ i}, B i j * y j + ∑ j ∈ {t | t < i}, B i j * x_0 j
--⋄ (y_i_eq A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec)
lemma y_i_eq
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ∀i, ((GaussSeidel A hA b x0).M *ᵥ x_0) i = ∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (((GaussSeidel A hA b x0).M *ᵥ x_0) j) + ∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)
  := by

  let y := (GaussSeidel A hA b x0).M *ᵥ x_0
  intro i

  have h1 : ∀i, ((GaussSeidel A hA b x0).M *ᵥ x_0) i
  =
  ((diagonal_inv A * (-lowerPart A)) *ᵥ (GaussSeidel A hA b x0).M *ᵥ x_0) i
  +
  ((diagonal_inv A * -upperPart A)*ᵥ x_0) i
  := by
    intro i
    conv =>
      lhs
      rw [y_eq1 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec]
    rw [← B_upperPart A hA b x0, ← B_lowerPart A hA b x0]
    exact rfl
  rw [h1]
  have h2 : ((diagonal_inv A * (-lowerPart A)) *ᵥ (GaussSeidel A hA b x0).M *ᵥ x_0) i
  =
  ∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (((GaussSeidel A hA b x0).M *ᵥ x_0) j)
  := by
    rw [← B_lowerPart A hA b x0]
    unfold lowerPart

    sorry
  have h3 : ((diagonal_inv A * -upperPart A)*ᵥ x_0) i
  =
  ∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)
  := by
    sorry
  rw [h2,h3]

-- ‖y‖ ≤ (‖y‖ * l i) + u i
-- (y_ineq A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)
lemma y_ineq
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  (hi : |((GaussSeidel A hA b x0).M *ᵥ x_0) i| = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖ ≤ ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖ * (Vector_l A hA b x0 i) + (Vector_u A hA b x0 i) := by
  let y := (GaussSeidel A hA b x0).M *ᵥ x_0
  have h251 : |y i| = |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j) + ∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| := by
      exact congrArg abs (y_i_eq A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec i)

  have h252 : |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j) + ∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| ≤ |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j)| + |∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| := by
    (expose_names; exact abs_add_le (∑ j ∈ {t | t ≥ i}, (Jacobi A hA b x0).M i j * y j) (∑ j ∈ {t | t < i}, (Jacobi A hA b x0).M i j * x_0 j))

  have h253 : |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j)| + |∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| ≤ ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j) * (y j)| + ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j) * (x_0 j)| := by
    have h1 : |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j)| ≤ ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j) * (y j)| := by
      (expose_names; exact abs_sum_le_sum_abs (fun i_1 ↦ (Jacobi A hA b x0).M i i_1 * y i_1) {t | t ≥ i})
    have h2 : |∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| ≤ ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j) * (x_0 j)| := by
      (expose_names; exact abs_sum_le_sum_abs (fun i_1 ↦ (Jacobi A hA b x0).M i i_1 * x_0 i_1) {t | t < i})
    exact add_le_add h1 h2

  have h254 : ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j) * (y j)| + ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j) * (x_0 j)| = ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * |(y j)| + ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| * |(x_0 j)| := by
    have h1 : ∀ j, |((Jacobi A hA b x0).M i j) * (y j)| = |((Jacobi A hA b x0).M i j)| * |(y j)| := by
      exact fun j ↦ abs_mul ((Jacobi A hA b x0).M i j) (y j)
    have h2 : ∀ j, |((Jacobi A hA b x0).M i j) * (x_0 j)| = |((Jacobi A hA b x0).M i j)| * |(x_0 j)| := by
      exact fun j ↦ abs_mul ((Jacobi A hA b x0).M i j) (x_0 j)
    have h3 : ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j) * (y j)| = ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * |(y j)| := by
      exact sum_congr rfl fun «x» a ↦ h1 «x»
    have h4 : ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j) * (x_0 j)| = ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| * |(x_0 j)| := by
      exact sum_congr rfl fun «x» a ↦ h2 «x»
    rw [h3, h4]

  have h255' : ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| * |(x_0 j)| ≤ ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| := by
    calc
      ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| * |(x_0 j)| ≤ ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| * 1 := by
        apply Finset.sum_le_sum
        intro j
        have h255'1 : |(x_0 j)| ≤ 1 := by
          exact (x_0_i_le_one A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec) j
        have h255'2 : |((Jacobi A hA b x0).M i j)| ≥ 0 := by
          exact abs_nonneg ((Jacobi A hA b x0).M i j)
        exact fun a ↦ mul_le_mul_of_nonneg_left ((x_0_i_le_one A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec) j) h255'2
      _ = ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| := by
        simp only [mul_one]

  have h255 : ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * |(y j)| ≤ ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * ‖y‖ := by
    apply Finset.sum_le_sum
    intro j
    have h2551 : |((Jacobi A hA b x0).M i j)| ≥ 0 := by
      exact abs_nonneg ((Jacobi A hA b x0).M i j)
    have h2552 : |y j| ≤ ‖y‖ := by
      exact y_j_le_ynorm A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec j
    exact fun a ↦ mul_le_mul_of_nonneg_left (y_j_le_ynorm A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec j) h2551

  have h256 : ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * ‖y‖ = Vector_l A hA b x0 i * ‖y‖ := by
    unfold Vector_l
    rw [sum_mul]

  calc
      ‖y‖ = |y i| := id (Eq.symm hi)
    _ = |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j) + ∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| := h251
    _ ≤ |∑ j ∈ {t | t ≥ i}, ((Jacobi A hA b x0).M i j) * (y j)| + |∑ j ∈ {t | t < i}, ((Jacobi A hA b x0).M i j) * (x_0 j)| := h252
    _ ≤ ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j) * (y j)| + ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j) * (x_0 j)| := h253
    _ = ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * |(y j)| + ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| * |(x_0 j)| := h254
    _ ≤ ∑ j ∈ {t | t ≥ i}, |((Jacobi A hA b x0).M i j)| * ‖y‖ + ∑ j ∈ {t | t < i}, |((Jacobi A hA b x0).M i j)| := by
      exact add_le_add h255 h255'
    _ = Vector_l A hA b x0 i * ‖y‖ + Vector_u A hA b x0 i := by
      exact congrFun (congrArg HAdd.hAdd h256) (∑ j ∈ {t | t < i}, |(Jacobi A hA b x0).M i j|)
    _ = ‖y‖ * Vector_l A hA b x0 i + Vector_u A hA b x0 i := by
      rw [mul_comm]

-- ‖y‖ ≤ (u i) / (1 - l i)
-- (y_ineq2 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)
lemma y_ineq2
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  (hi : |((GaussSeidel A hA b x0).M *ᵥ x_0) i| = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖ ≤ (Vector_u A hA b x0 i) / (1 - (Vector_l A hA b x0 i))
  := by
  let y := (GaussSeidel A hA b x0).M *ᵥ x_0
  have h1 : ‖y‖ * (1 - Vector_l A hA b x0 i) ≤ Vector_u A hA b x0 i := by
    calc
      ‖y‖ * (1 - Vector_l A hA b x0 i) = ‖y‖ - ‖y‖ * Vector_l A hA b x0 i := by
        (expose_names; exact mul_one_sub ‖y‖ (Vector_l A hA b x0 i))
      _  ≤ Vector_u A hA b x0 i := by
        exact tsub_le_iff_left.mpr (y_ineq A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)

  have one_sub_l_i_gt_zero : 1 - Vector_l A hA b x0 i > 0 := by
    exact sub_pos.mpr (l_i_lt_one A hA b x0 h0)
  exact (le_div_iff₀ one_sub_l_i_gt_zero).mpr h1


