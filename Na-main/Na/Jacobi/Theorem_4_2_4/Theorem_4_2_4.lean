--  D ⁻¹ = D⁻¹
-- inv_eq A hA
omit [NeZero n] in
lemma inv_eq
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  :
  (diagPart A)⁻¹ = diagonal_inv A
  := by
  ext i j
  rw [Matrix.inv_def]
  unfold diagonal_inv
  by_cases h : i = j
  . split_ifs
    rw [h]
    simp only [det_diagonal, Ring.inverse_eq_inv', adjugate_diagonal, smul_apply, diagonal_apply_eq, smul_eq_mul, one_div]
    refine (IsUnit.inv_mul_eq_iff_eq_mul ?_).mpr ?_
    . have h1 : ∏ i, A i i ≠ 0 := by
        exact prod_ne_zero_iff.mpr fun a a_1 ↦ hA a
      exact Ne.isUnit h1
    . refine Eq.symm (CancelDenoms.inv_subst (hA j) ?_)
      refine prod_erase_mul univ (fun «x» ↦ A «x» «x») ?_
      exact mem_univ j
  . split_ifs
    simp only [det_diagonal, Ring.inverse_eq_inv', adjugate_diagonal, smul_apply, smul_eq_mul, mul_eq_zero, inv_eq_zero]
    right
    exact diagonal_apply_ne' (fun i ↦ ∏ i ∈ univ.erase i, A i i) fun a ↦ h (id (Eq.symm a))

-- B.lowerPart = D⁻¹ * L
-- B_lowerPart A hA b x0
omit [NeZero n] in
lemma B_lowerPart
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  lowerPart (Jacobi A hA b x0).M = (diagonal_inv A) * -A.lowerPart := by
  simp [Jacobi]
  refine ext ?_
  intro i j
  have h1 : ((diagonal_inv A) * (A.lowerPart)) i j = ∑ k, ((diagonal_inv A) i k) * ((A.lowerPart) k j) := rfl
  conv =>
    lhs
    unfold lowerPart
  simp only [ge_iff_le, neg_apply]
  rw [h1]
  by_cases h : i ≤ j
  . split_ifs
    unfold diagonal_inv
    simp only [one_div, ite_mul, zero_mul, sum_ite_eq, mem_univ, ↓reduceIte, zero_eq_neg, mul_eq_zero, inv_eq_zero]
    right
    unfold lowerPart
    split_ifs
    exact rfl
    exact rfl
  . split_ifs
    unfold diagonal_inv
    simp only [one_div, ite_mul, zero_mul, sum_ite_eq, mem_univ, ↓reduceIte]
    unfold lowerPart
    simp only [ge_iff_le, mul_ite, mul_zero]
    split_ifs
    have h2 : ((diagPart A)⁻¹ * ((diagPart A) - A)) i j = ∑ k, (diagPart A)⁻¹ i k * (diagPart A - A) k j := rfl
    rw [h2]
    rw [inv_eq A hA]
    unfold diagonal_inv
    simp only [one_div, sub_apply, ite_mul, zero_mul, sum_ite_eq, mem_univ, ↓reduceIte]
    have h3 : (diagPart A) i j = 0 := by
      unfold diagPart
      simp only [not_le] at h
      have h4 : i ≠ j := by
        exact Ne.symm (Fin.ne_of_lt h)
      exact diagonal_apply_ne' (fun i ↦ A i i) (id (Ne.symm h4))
    rw [h3]
    simp only [zero_sub, mul_neg]

-- B.upperPart = D⁻¹ * U
-- B_upperPart A hA b x0
omit [NeZero n] in
lemma B_upperPart
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  upperPart (Jacobi A hA b x0).M = (diagonal_inv A) * -A.upperPart := by
  simp [Jacobi]
  refine ext ?_
  intro i j
  have h1 : ((diagonal_inv A) * (A.upperPart)) i j = ∑ k, ((diagonal_inv A) i k) * ((A.upperPart) k j) := rfl
  conv =>
    lhs
    unfold upperPart
  simp only [neg_apply]
  rw [h1]
  by_cases h : j ≤ i
  . split_ifs
    unfold diagonal_inv
    simp only [one_div, ite_mul, zero_mul, sum_ite_eq, mem_univ, ↓reduceIte, zero_eq_neg, mul_eq_zero, inv_eq_zero]
    right
    unfold upperPart
    simp only [ite_eq_left_iff, not_le]
    intro h'
    contrapose h
    simp only [not_le]
    exact h'
  . split_ifs
    unfold diagonal_inv
    simp only [one_div, ite_mul, zero_mul, sum_ite_eq, mem_univ, ↓reduceIte]
    unfold upperPart
    simp only [mul_ite, mul_zero]
    split_ifs
    have h2 : ((diagPart A)⁻¹ * ((diagPart A) - A)) i j = ∑ k, (diagPart A)⁻¹ i k * (diagPart A - A) k j := rfl
    rw [h2]
    rw [inv_eq A hA]
    unfold diagonal_inv
    simp only [one_div, sub_apply, ite_mul, zero_mul, sum_ite_eq, mem_univ, ↓reduceIte]
    have h3 : (diagPart A) i j = 0 := by
      unfold diagPart
      have h4 : i ≠ j := by
        exact Ne.symm (ne_of_not_le h)
      exact diagonal_apply_ne' (fun i ↦ A i i) (id (Ne.symm h4))
    rw [h3]
    simp only [zero_sub, mul_neg]

-- ‖B‖_∞ ≥ 0
omit [NeZero n] in
lemma L_1_norm_nonneg
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  :
  ‖(GaussSeidel A hA b x0).M‖_∞ ≥ 0
  := by
  simp only [ge_iff_le, norm_nonneg]

-- μ < 1
lemma μ_lt_one
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  :
  mu A hA b x0 < 1 := by
  calc
    mu A hA b x0 ≤ ‖ (Jacobi A hA b x0).M ‖_∞ := by
      exact h1_lemma2 A hA b x0 h_x_star_eq
    _ < 1 := by
      (expose_names; exact h0)

