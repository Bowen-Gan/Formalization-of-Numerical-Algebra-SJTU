-- ∃ i, |y i| = ‖y‖
-- y_i_eq_ynorm A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec
lemma y_i_eq_ynorm
  (A : Matrix (Fin n) (Fin n) ℝ)
