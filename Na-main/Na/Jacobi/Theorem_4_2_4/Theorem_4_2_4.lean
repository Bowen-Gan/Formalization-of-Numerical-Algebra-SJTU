-- ‖L₁‖_∞ ≤ μ
-- hL_1_le_μ A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi
lemma hL_1_le_μ
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  (hi : |((GaussSeidel A hA b x0).M *ᵥ x_0) i| = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ‖(GaussSeidel A hA b x0).M‖_∞ ≤ mu A hA b x0 := by
  calc
    ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖ := L_1_eq_mulvec
    _ ≤ (Vector_u A hA b x0 i) / (1 - (Vector_l A hA b x0 i)) := (y_ineq2 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)
    _ ≤ mu A hA b x0 := by
      exact h2_lemma2 A hA b x0 i

-- ‖ L₁ ‖_∞ < 1
-- L_1norm_lt_1 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi
lemma L_1norm_lt_1
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  (hi : |((GaussSeidel A hA b x0).M *ᵥ x_0) i| = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ‖ (GaussSeidel A hA b x0).M ‖_∞ < 1 := by
  calc
    ‖(GaussSeidel A hA b x0).M‖_∞ ≤ mu A hA b x0 := (hL_1_le_μ A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)
    _ < 1 := μ_lt_one A hA b x0 h_x_star_eq h0

-- ∀ (k : ℕ), ‖B‖_∞ ^ k / (1 - ‖B‖_∞) * ‖x 1 - x 0‖ ≤ μ ^ k / (1 - μ) * ‖x 1 - x 0‖
-- h3pre A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi
lemma h3pre
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  (hi : |((GaussSeidel A hA b x0).M *ᵥ x_0) i| = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
  ∀ k, (‖(GaussSeidel A hA b x0).M‖_∞ ^ k / (1 - ‖(GaussSeidel A hA b x0).M‖_∞)) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖ ≤ (mu A hA b x0 ^ k / (1 - mu A hA b x0)) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖
  := by
  intro k
  have h3p1 : ‖(GaussSeidel A hA b x0).M‖_∞ ^ k / (1 - ‖(GaussSeidel A hA b x0).M‖_∞) ≤ mu A hA b x0 ^ k / (1 - mu A hA b x0) := by
    have h3p11 : ‖(GaussSeidel A hA b x0).M‖_∞ ^ k ≤ mu A hA b x0 ^ k := by
      exact pow_le_pow_left₀ (L_1_norm_nonneg A hA b x0) (hL_1_le_μ A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi) k
    have h3p12 : 1 - ‖(GaussSeidel A hA b x0).M‖_∞ > 0 := by
      exact sub_pos.mpr (L_1norm_lt_1 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)
    have h3p13 : 0 < 1 - mu A hA b x0 := sub_pos.mpr (μ_lt_one A hA b x0 h_x_star_eq h0)
    have h3p14 : 1 - mu A hA b x0 ≤ 1 - ‖(GaussSeidel A hA b x0).M‖_∞ := tsub_le_tsub_left (hL_1_le_μ A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi) 1
    refine (div_le_div_iff₀ h3p12 h3p13).mpr ?_
    refine mul_le_mul_of_nonneg h3p11 h3p14 ?_ ?_
    . exact pow_nonneg (L_1_norm_nonneg A hA b x0) k
    . exact le_of_lt h3p12
  refine mul_le_mul_of_nonneg_right h3p1 ?_
  exact norm_nonneg ((GaussSeidel A hA b x0).x 1 - (GaussSeidel A hA b x0).x 0)

--  ∀ (k : ℕ), ‖x k - x_star‖ ≤ μ ^ k / (1 - μ) * ‖x 1 - x 0‖
-- h3here A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi
lemma h3here
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  (x_0_eq_one : ‖x_0‖ = 1)
  (L_1_eq_mulvec : ‖(GaussSeidel A hA b x0).M‖_∞ = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  (hi : |((GaussSeidel A hA b x0).M *ᵥ x_0) i| = ‖(GaussSeidel A hA b x0).M *ᵥ x_0‖)
  :
   ∀ k, ‖G_SIterativeVector A hA b x0 k - x_star‖ ≤ mu A hA b x0 ^ k / (1 - mu A hA b x0) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖
   := by
  intro k
  calc
    ‖G_SIterativeVector A hA b x0 k - x_star‖ ≤ (‖(GaussSeidel A hA b x0).M‖_∞ ^ k / (1 - ‖(GaussSeidel A hA b x0).M‖_∞)) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖ := by
      exact SG_4_2_2_corollary A hA b x0 h_x_star_eq k
    _ ≤ mu A hA b x0 ^ k / (1 - mu A hA b x0) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖ := by
      (expose_names; exact (h3pre A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi) k)


-- ============= body proof ===============
-- ‖L₁‖_∞ < 1 ∧ (∀ k, ‖x k - x_star‖ ≤ μ ^ k / (1 - μ) * ‖x 1 - x 0‖) ∧ μ ≤ ‖B‖_∞
theorem Theorem_4_2_4
  (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : ∀ i, A i i ≠ 0)
  (b : Fin n → ℝ)
  (x0 : Fin n → ℝ)
  (h_x_star_eq : x_star = (Jacobi A hA b x0).M *ᵥ x_star + (GaussSeidel A hA b x0).g)
  (h0 : ‖(Jacobi A hA b x0).M‖_∞ < 1)
  :
  (‖(GaussSeidel A hA b x0).M‖_∞ < 1) ∧ (∀ k, ‖G_SIterativeVector A hA b x0 k - x_star‖ ≤ mu A hA b x0 ^ k / (1 - mu A hA b x0) * ‖G_SIterativeVector A hA b x0 1 - G_SIterativeVector A hA b x0 0‖) ∧ (mu A hA b x0 ≤ ‖ (Jacobi A hA b x0).M ‖_∞ )
  := by

  -- 找一个中间变量来辅助估计
  rcases h2_lemma1 A hA b x0 h_x_star_eq with ⟨x_0, x_0_eq_one, L_1_eq_mulvec⟩ -- intro x_0
  let y := (GaussSeidel A hA b x0).M *ᵥ x_0 -- let y
  rcases y_i_eq_ynorm A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec with ⟨i, hi⟩ -- intro i0

  -- 拆解结论
  constructor
  . exact (L_1norm_lt_1 A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi)
  . constructor
    . intro k
      exact (h3here A hA b x0 h_x_star_eq h0 x_0_eq_one L_1_eq_mulvec hi) k
    . exact h1_lemma2 A hA b x0 h_x_star_eq
